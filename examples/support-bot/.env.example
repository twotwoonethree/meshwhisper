# Mode: 'echo' replies with the same text (no API key needed, useful for
# verifying the wiring); 'llm' calls Claude for replies.
BOT_MODE=echo

# Username the bot publishes to the relay's directory. Users add the bot
# by calling addContactByKey('<this-username>') in their app. On the
# shared Foundation relay this username may already be taken — pick
# something unique to your deployment (e.g. acme-support-bot).
BOT_USERNAME=support-bot

# Namespace — must match what your users' app uses (e.g. the same string
# Prudence passes to MeshWhisper.init). Apps in different namespaces are
# isolated from each other on the relay.
BOT_NAMESPACE=org.example.support-bot

# Where the bot persists its identity, sessions and message history.
BOT_DATA_DIR=./bot-data

# Relay endpoint. The Foundation-run relay is the default; for production
# you usually want your own self-hosted node.
MESHWHISPER_NODE=wss://relay.meshwhisper.org

# Required only when BOT_MODE=llm. Get one from https://console.anthropic.com.
ANTHROPIC_API_KEY=
