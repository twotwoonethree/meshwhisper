# Relay to connect through (default: the public Foundation relay)
# MESHWHISPER_NODE=wss://relay.meshwhisper.org
# For a local relay: MESHWHISPER_NODE=ws://127.0.0.1:8080

# Shared app namespace + developer key (every actor must match)
# NAMESPACE=org.example.customer-service
# MESHWHISPER_DEV_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Identities (registered usernames; the customer is a guest with none)
# DISPATCH_USERNAME=acme-dispatch
# SUPERVISOR_USERNAME=acme-supervisor
# AGENT_USERNAME=acme-agent-1
# CS_AGENTS=acme-agent-1,acme-agent-2   # dispatcher's routing pool

# How often agents advertise availability to the dispatcher (ms)
# CS_HEARTBEAT_MS=4000
