# Namespace shared by all three actors (customer's app, agent, supervisor).
# Apps in different namespaces are isolated on the relay.
NAMESPACE=org.example.supervised-chat

# Relay endpoint. Self-host in production.
MESHWHISPER_NODE=wss://relay.meshwhisper.org

# --- Agent ---
# Username the agent publishes to the relay's directory.
AGENT_USERNAME=acme-support
AGENT_DATA_DIR=./data/agent

# --- Supervisor ---
# Username the supervisor publishes. Customers see this in the group roster
# so the supervision is cryptographically transparent.
SUPERVISOR_USERNAME=acme-compliance
SUPERVISOR_DATA_DIR=./data/supervisor
# Append-only JSON-Lines audit log of every message the supervisor receives.
SUPERVISOR_AUDIT_LOG=./data/supervisor/audit.jsonl
