{
  "name": "@meshwhisper/example-supervised-chat-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Search + audit UI over the supervisor bot's JSONL log",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx --watch server.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build"
  },
  "dependencies": {
    "flexsearch": "^0.7.43",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
