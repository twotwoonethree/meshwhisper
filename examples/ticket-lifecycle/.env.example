# Shared by all three actors. Apps in different namespaces are isolated.
NAMESPACE=org.example.ticket-lifecycle

# Relay endpoint. Self-host in production.
MESHWHISPER_NODE=wss://relay.meshwhisper.org

# --- Triage bot (LLM front-line) ---
# Public-facing username — the customer adds @acme-triage as a contact.
TRIAGE_USERNAME=acme-triage
TRIAGE_DATA_DIR=./data/triage
# Required: Claude API key for the LLM that decides whether to handle or escalate.
ANTHROPIC_API_KEY=

# --- Human agent (the escalation target) ---
AGENT_USERNAME=acme-human-agent
AGENT_DATA_DIR=./data/agent

# --- Compliance supervisor ---
SUPERVISOR_USERNAME=acme-compliance
SUPERVISOR_DATA_DIR=./data/supervisor
SUPERVISOR_AUDIT_LOG=./data/supervisor/audit.jsonl
