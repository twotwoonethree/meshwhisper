---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Blog — MeshWhisper" description="Announcements and engineering notes from the MeshWhisper project.">
  <Nav current="Blog" />

  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-white mb-2">Blog</h1>
    <p class="text-slate-400 mb-12">
      Announcements and engineering notes.
      <a href="/rss.xml" class="text-brand-400 hover:text-brand-300 transition-colors">RSS</a>
    </p>

    <div class="space-y-10">
      {posts.map((post) => (
        <article>
          <div class="text-slate-500 text-sm font-mono mb-1">{fmt(post.data.pubDate)}</div>
          <h2 class="text-2xl font-bold">
            <a href={`/blog/${post.id}/`} class="text-white hover:text-brand-300 transition-colors">
              {post.data.title}
            </a>
          </h2>
          <p class="text-slate-400 mt-2 leading-relaxed">{post.data.description}</p>
        </article>
      ))}
    </div>
  </main>
</Layout>
