---
import ComingSoonModal from '../components/ComingSoonModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MeshWhisper — E2EE messaging for your app',
  description = 'Add end-to-end encrypted messaging to any app. One Docker container. Cannot read your users\' messages — not as a policy, by design.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased">
    <slot />
    <ComingSoonModal />
  </body>
</html>
