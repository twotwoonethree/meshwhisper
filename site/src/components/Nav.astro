---
interface Props {
  current?: string;
}
const { current } = Astro.props;

const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/security', label: 'Security' },
  { href: '#', label: 'Docs', comingSoon: true },
];
---

<header class="border-b border-slate-800">
  <nav class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/">
      <img src="/logo-long.png" alt="MeshWhisper" class="h-16 object-contain object-left" />
    </a>
    <div class="flex items-center gap-6 text-sm">
      {links.map(({ href, label, comingSoon }) => (
        <a
          href={href}
          data-coming-soon={comingSoon ? '' : undefined}
          class={`transition-colors ${current === label ? 'text-white' : 'text-slate-400 hover:text-white'}`}
        >
          {label}
        </a>
      ))}
      <a href="#" data-coming-soon class="text-slate-400 hover:text-white transition-colors">
        GitHub
      </a>
      <a href="/#integrate" class="bg-brand-500 hover:bg-brand-400 text-white px-4 py-1.5 rounded-md font-medium transition-colors">
        Get started
      </a>
    </div>
  </nav>
</header>
