---
interface Props {
  current?: string;
}
const { current } = Astro.props;

const links = [
  { href: '/how-it-works', label: 'How it works', external: false },
  { href: '/security', label: 'Security', external: false },
  { href: '/live', label: 'Live', external: false },
  { href: '/blog', label: 'Blog', external: false },
  { href: 'https://github.com/twotwoonethree/meshwhisper#documentation', label: 'Docs', external: true },
];
---

<header class="border-b border-slate-800">
  <nav class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/">
      <img src="/logo-long.png" alt="MeshWhisper" class="h-16 object-contain object-left" />
    </a>
    <div class="flex items-center gap-6 text-sm">
      {links.map(({ href, label, external }) => (
        <a
          href={href}
          {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class={`transition-colors ${current === label ? 'text-white' : 'text-slate-400 hover:text-white'}`}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/twotwoonethree/meshwhisper"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-white transition-colors"
      >
        GitHub
      </a>
      <a href="/#integrate" class="bg-brand-500 hover:bg-brand-400 text-white px-4 py-1.5 rounded-md font-medium transition-colors">
        Get started
      </a>
    </div>
  </nav>
</header>
