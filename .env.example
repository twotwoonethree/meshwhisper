# MeshWhisper environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ---- Node (relay) ----
# Public URL of your relay server (used to construct media download links)
BASE_URL=https://relay.myapp.com

# Port the relay listens on (default: 8080)
# NODE_PORT=8080

# Store-and-forward TTL in hours (default: 72)
# BLOB_TTL_HOURS=72

# ---- Push service ----
# Web Push / VAPID — generate with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@myapp.com

# APNs (iOS) — optional
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_BUNDLE_ID=com.example.myapp

# FCM (Android) — optional
# FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FCM_PROJECT_ID=my-firebase-project
